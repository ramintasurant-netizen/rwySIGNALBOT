# Salin ke .env dan isi. JANGAN commit .env. Semua nilai di bawah adalah default aman.

# --- Aplikasi ---
APP_ENV=development            # development | production
APP_MODE=dry_run               # dry_run | live
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO
LOG_DIAGNOSE=false             # true hanya untuk debugging lokal (traceback memuat nilai variabel)
VAR_DIR=var
CONFIG_DIR=config

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///var/dev.db
# production: DATABASE_URL=postgresql+asyncpg://user:password@host:5432/stock_signal_bot
ALLOW_SQLITE_IN_PRODUCTION=false

# --- Telegram (isi lewat pengelola secret / .env lokal, bukan di repo) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLE_LIVE_SEND=false
# Grup/supergroup/channel tujuan (ID negatif), pisahkan koma; opsional :thread_id untuk topik forum
TELEGRAM_SIGNAL_CHAT_IDS=
# Grup operasional admin (ID negatif). Kosong = alert hanya ke log; tidak ada fallback ke chat pribadi
TELEGRAM_ADMIN_CHAT_ID=
# Whitelist user_id admin (positif), pisahkan koma
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_COMMAND_COOLDOWN_SECONDS=60
# Pesan pembuka sebelum laporan (default hanya bila ada setup)
TEASER_ENABLED=true
TEASER_TEXT=🔔 Are you ready for IHSG SIGNAL? 🔔
TEASER_ONLY_WITH_SIGNALS=true

# --- Jadwal WIB ---
SCHEDULE_MORNING=08:30
SCHEDULE_AFTERNOON=15:00

# --- LLM (opsional; none = template deterministik) ---
LLM_PROVIDER=none              # none | openai | anthropic | openai_compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- Provider data ---
PROVIDER_PRIORITY=yahoo        # urutan failover; tambahkan ",local_flow" bila FLOW_CSV_DIR diisi
# Data foreign flow & broker summary dari CSV yang Anda ekspor sendiri (lihat README):
#   <FLOW_CSV_DIR>/foreign_flow/<SYMBOL>.csv   date,buy_value,sell_value
#   <FLOW_CSV_DIR>/broker_summary/<SYMBOL>.csv date,broker,buy_value,sell_value
FLOW_CSV_DIR=
FLOW_HISTORY_SESSIONS=5
PRODUCTION_SINGLE_PROVIDER_APPROVED=false
GOAPI_ENABLED=false
GOAPI_API_KEY=
SECTORS_ENABLED=false
SECTORS_API_KEY=
BROKER_X_ENABLED=false
BROKER_X_API_KEY=
DATA_REQUEST_TIMEOUT_SECONDS=20
DATA_MAX_CONCURRENCY=4
DATA_CACHE_TTL_SECONDS=300
DATA_MAX_RETRIES=2
DATA_RETRY_BACKOFF_SECONDS=1.0
DATA_BREAKER_FAILURE_THRESHOLD=3
DATA_BREAKER_COOLDOWN_SECONDS=120
DATA_RATE_LIMIT_PER_MINUTE=60
CROSS_VALIDATION_MAX_DIFF_PCT=0.5
INTRADAY_MAX_AGE_MINUTES=20
DAILY_MIN_HISTORY_BARS=250

# --- WhatsApp: hanya ekspor teks manual untuk Saluran ---
WHATSAPP_EXPORT_ENABLED=false

# --- Engine: sizing contoh, risk, scorer (nilai CONTOH; biaya BELUM TERVERIFIKASI) ---
SIZING_CAPITAL_EXAMPLE=100000000
SIZING_RISK_PCT=1.0
RISK_ATR_MULTIPLE=1.5
RISK_MIN_RR=2.0                # berlaku pada TP1 setelah pembulatan & biaya
RISK_FEE_BUY_PCT=0.15
RISK_FEE_SELL_PCT=0.25
RISK_APPLY_FEES_TO_RR=true
RISK_MAX_ENTRY_ZONE_PCT=3.0
# Filter rezim pasar: indeks acuan Yahoo; bearish (close<EMA50<EMA200) ⇒ tidak ada setup long baru
REGIME_ENABLED=true
REGIME_INDEX_SYMBOL=^JKSE
REGIME_FAST=50
REGIME_SLOW=200
REGIME_POLICY_ON_UNKNOWN=block   # block (fail-closed) | allow
REGIME_BLOCK_NEUTRAL=false
SCORER_THRESHOLD=70
SCORER_MAX_SIGNALS=5
SCORER_DEGRADED_PENALTY=10
